{
  "name": "mindnotes-pro",
  "version": "5.1.2",
  "type": "module",
  "description": "A local-first lightweight whiteboard for drawing, editable templates, and portable exports.",
  "author": "11suixing11",
  "homepage": "https://github.com/11suixing11/mindnotes-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/11suixing11/mindnotes-pro.git"
  },
  "desktopName": "mindnotes-pro.desktop",
  "main": "dist-electron/main.mjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && concurrently \"vite\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build -- --base=./ && npm run build:electron && electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node benchmark/run-performance-benchmark.mjs",
    "benchmark:browser": "node benchmark/run-browser-performance-benchmark.mjs",
    "benchmark:compare": "node benchmark/compare-performance.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"electron/**/*.mts\"",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build": "npm run build:desktop"
  },
  "build": {
    "appId": "com.mindnotes.pro",
    "productName": "MindNotes Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/icons/icon-512x512.png",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "perfect-freehand": "^1.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
